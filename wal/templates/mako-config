# pywal16 → mako
font=JetBrains Mono 10
anchor=top-right
layer=overlay
width=360
height=160
margin=12,14
padding=12,14
outer-margin=50,0,0,0
border-size=2
border-radius=10
border-color={color4}
background-color={background}D9
text-color={foreground}
progress-color=over {color5}
