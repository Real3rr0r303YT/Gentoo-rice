#!/usr/bin/env bash
# Darkroot OS – Nacharbeiten, die Calamares im neuen System (chroot) aufruft
#   cleanup  Live-Reste entfernen (Live-Benutzer, Autologin, Installer-Autostart), Dienste aktivieren
#   rice     Gentoo-rice in das Home des neuen Benutzers legen + Autostart für den ersten Login
# Copyright (C) 2026 3rr0r303YT – GPL-3.0-or-later
set -uo pipefail
RICE_SRC=/opt/darkroot/Gentoo-rice

# der von Calamares angelegte Benutzer (erste normale UID)
new_user() { awk -F: '$3 >= 1000 && $3 < 60000 && $1 != "gentoo" && $1 != "nobody" {print $1; exit}' /etc/passwd; }

cleanup() {
    # Live-Benutzer und seine Sonderrechte
    if id gentoo >/dev/null 2>&1; then userdel -r gentoo 2>/dev/null || userdel gentoo 2>/dev/null || true; fi
    rm -f /etc/sudoers.d/*live* /etc/sudoers.d/gentoo 2>/dev/null || true
    # Autologin des Live-Systems und Installer-Autostart
    grep -rl -i 'autologin\|^User=gentoo' /etc/sddm.conf /etc/sddm.conf.d 2>/dev/null | xargs -r rm -f
    rm -f /etc/xdg/autostart/darkroot-installer.desktop /usr/share/applications/darkroot-installer.desktop
    rm -rf /etc/calamares
    # Dienste fürs installierte System
    for s in NetworkManager elogind dbus display-manager; do
        if [[ -x /etc/init.d/$s ]]; then rc-update add "$s" default >/dev/null 2>&1 || true; fi
    done
    # Name im Bootmenü: "Darkroot" statt "Gentoo GNU/Linux"
    if [[ -f /etc/default/grub ]]; then
        if grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub; then sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Darkroot"/' /etc/default/grub
        else echo 'GRUB_DISTRIBUTOR="Darkroot"' >> /etc/default/grub; fi
        grep -q '^GRUB_TIMEOUT=' /etc/default/grub || echo 'GRUB_TIMEOUT=5' >> /etc/default/grub
    fi
    # passendes initramfs für die Platte (das Live-initramfs sucht die ISO)
    if command -v dracut >/dev/null; then
        for k in /lib/modules/*; do
            kv=$(basename "$k")
            if [[ -f /boot/vmlinuz-$kv ]]; then dracut --force --hostonly "/boot/initramfs-$kv.img" "$kv" >/dev/null 2>&1 || true; fi
        done
    fi
    return 0
}

rice() {
    local u home
    u=$(new_user)
    [[ -n $u ]] || { echo "Kein Benutzer gefunden"; return 0; }
    home=$(getent passwd "$u" | cut -d: -f6)
    if [[ -d $RICE_SRC ]]; then
        rm -rf "$home/Gentoo-rice"
        cp -a "$RICE_SRC" "$home/Gentoo-rice"
    fi
    # beim ersten Login: Terminal öffnet sich und installiert das Rice (Hyprland, Mac-Login, Apps)
    mkdir -p "$home/.config/autostart" "$home/.local/bin"
    cat > "$home/.local/bin/darkroot-firstboot" <<'FIRSTBOOT'
#!/bin/sh
# Darkroot OS – einmalig nach dem ersten Login: Gentoo-rice installieren
rm -f "$HOME/.config/autostart/darkroot-rice.desktop"
run='cd ~/Gentoo-rice && ./install.sh --login=mac; echo; echo "Fertig – neu starten: loginctl reboot"; exec bash'
for t in konsole kitty xterm; do
    if command -v "$t" >/dev/null; then exec "$t" -e bash -c "$run"; fi
done
FIRSTBOOT
    chmod +x "$home/.local/bin/darkroot-firstboot"
    cat > "$home/.config/autostart/darkroot-rice.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Darkroot – Rice einrichten
Exec=$home/.local/bin/darkroot-firstboot
X-GNOME-Autostart-enabled=true
DESKTOP
    chown -R "$u:$u" "$home/Gentoo-rice" "$home/.config" "$home/.local"
    rm -rf /opt/darkroot
    echo "Gentoo-rice für $u bereit ($home/Gentoo-rice)"
}

case ${1:-} in
    cleanup) cleanup ;;
    rice)    rice ;;
    *) echo "Nutzung: $0 cleanup|rice" >&2; exit 1 ;;
esac
exit 0
