{
    "// gentoo-rice": "von scripts/dev-setup.sh angelegt – Marker entfernen, damit es nie überschrieben wird",

    "workbench.colorTheme": "GitHub Dark Default",
    "workbench.iconTheme": "vs-seti",
    "workbench.startupEditor": "none",
    "workbench.list.smoothScrolling": true,
    "workbench.tree.indent": 14,
    "workbench.colorCustomizations": {
        "editor.background": "#1C1C1E",
        "editorGutter.background": "#1C1C1E",
        "sideBar.background": "#1C1C1E",
        "activityBar.background": "#1C1C1E",
        "panel.background": "#1C1C1E",
        "terminal.background": "#1C1C1E",
        "titleBar.activeBackground": "#1C1C1E",
        "titleBar.inactiveBackground": "#1C1C1E",
        "statusBar.background": "#1C1C1E",
        "statusBar.noFolderBackground": "#1C1C1E",
        "tab.inactiveBackground": "#1C1C1E",
        "tab.activeBackground": "#2C2C2E",
        "editorGroupHeader.tabsBackground": "#1C1C1E",
        "editorWidget.background": "#2C2C2E",
        "quickInput.background": "#2C2C2E",
        "dropdown.background": "#2C2C2E",
        "input.background": "#2C2C2E",
        "menu.background": "#2C2C2E",
        "focusBorder": "#0A84FF",
        "button.background": "#0A84FF",
        "activityBarBadge.background": "#0A84FF",
        "progressBar.background": "#0A84FF",
        "textLink.foreground": "#0A84FF",
        "editorCursor.foreground": "#F5F5F7",
        "foreground": "#F5F5F7",
        "contrastBorder": "#FFFFFF14",
        "sideBar.border": "#FFFFFF14",
        "panel.border": "#FFFFFF14",
        "titleBar.border": "#FFFFFF14",
        "statusBar.border": "#FFFFFF14",
        "tab.border": "#FFFFFF14",
        "editorGroup.border": "#FFFFFF14"
    },

    "window.titleBarStyle": "custom",
    "window.commandCenter": true,
    "window.menuBarVisibility": "toggle",
    "window.zoomLevel": 0,

    "editor.fontFamily": "'JetBrains Mono', monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.lineHeight": 1.6,
    "editor.smoothScrolling": true,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.minimap.enabled": false,
    "editor.renderLineHighlight": "all",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.padding.top": 12,
    "editor.formatOnSave": true,
    "editor.stickyScroll.enabled": true,

    "terminal.integrated.fontFamily": "'JetBrains Mono'",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.cursorStyle": "line",

    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    "python.analysis.typeCheckingMode": "basic",
    "errorLens.enabledDiagnosticLevels": ["error", "warning"],
    "gitlens.codeLens.enabled": false,
    "telemetry.telemetryLevel": "off",
    "update.mode": "none"
}
