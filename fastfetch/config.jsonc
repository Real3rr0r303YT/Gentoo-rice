// Gentoo-rice – fastfetch
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "gentoo_small",
        "color": {
            "1": "38;2;10;132;255",
            "2": "38;2;245;245;247"
        },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;10;132;255",
            "title": "38;2;245;245;247",
            "output": "38;2;245;245;247",
            "separator": "38;2;99;99;102"
        },
        "key": { "width": 10 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
        { "type": "separator", "string": "─" },
        { "type": "os",       "key": "OS",       "format": "{pretty-name}" },
        { "type": "kernel",   "key": "Kernel" },
        { "type": "uptime",   "key": "Uptime" },
        { "type": "packages", "key": "Packages" },
        { "type": "shell",    "key": "Shell" },
        { "type": "wm",       "key": "WM" },
        { "type": "terminal", "key": "Terminal" },
        { "type": "cpu",      "key": "CPU" },
        { "type": "gpu",      "key": "GPU" },
        { "type": "memory",   "key": "Memory" },
        { "type": "disk",     "key": "Disk",     "folders": "/" },
        "break",
        { "type": "colors",   "symbol": "circle" }
    ]
}
